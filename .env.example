# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Supabase — Project Settings → Database → Connection string → Transaction pooler.
# Pakai pooler (port 6543), bukan koneksi langsung, supaya aman di serverless.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Ekstraksi scoreboard & parsing ruleset. Kosongkan kalau fitur AI belum dipakai.
ANTHROPIC_API_KEY=""

# Email yang dikirim aplikasi sendiri (mis. undangan organisasi).
# CATATAN: email login/magic link TIDAK lewat sini — itu dikirim mailer internal
# Supabase. Untuk melepas rate limit-nya, pasang SMTP Resend di dashboard Supabase:
# Authentication → Emails → SMTP Settings.
RESEND_API_KEY=""
# Alamat pengirim. `onboarding@resend.dev` hanya bisa mengirim ke email pemilik
# akun Resend; untuk mengirim ke orang lain, verifikasi domain sendiri dulu.
EMAIL_FROM="onboarding@resend.dev"
